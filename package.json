{
  "name": "mr-reviewer",
  "version": "0.2.0",
  "description": "Local CLI that reviews GitLab merge requests with the internal LLM",
  "private": true,
  "type": "module",
  "bin": {
    "mr-reviewer": "bin/mr-reviewer.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "24.19.4",
    "typescript": "7.0.2"
  }
}
